# Copy to .env.dev / .env.prod / .env.local and fill in real values.
# Never commit the real files - they are listed in .gitignore.

# --- Database ---
POSTGRES_DB=careerpath_dev
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=change-me
DB_HOST=db

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/careerpath_dev
SPRING_DATASOURCE_USERNAME=cp_user
SPRING_DATASOURCE_PASSWORD=change-me

# --- Flyway ---
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# --- pgAdmin (prod compose only) ---
PGADMIN_DEFAULT_PASSWORD=change-me

# --- SonarQube (sonar compose only) ---
SONAR_DB_PASSWORD=change-me
